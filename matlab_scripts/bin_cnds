R_on=10e6; R_off=10e4; Vin_w=0.3; Vin_r=0.15;
[G_adj, Vin, Cnds]=init_cb(m,n,batch_size,Gwl,Gbl,0,R_on,R_off);
Cnds1=(Cnds==1)*(1/R_on)+(Cnds==0)*(1/R_off);
Vin1=(Vin==1)*Vin_w+(Vin==0)*Vin_r;

